# MAYogu LoadTest Tool — production image (Node, zero-dep runtime, tsx chạy TS).
#
# Build:
#   docker build -f docker/Dockerfile.loadtest -t mayogu-loadtest:latest .
#
# Chạy (env BẮT BUỘC — server fail-fast nếu thiếu, xem README "Vận hành"):
#   1. Migration 1 lần trước khi start (startup chỉ auto-apply baseline):
#        docker run --rm -v mayogu-data:/data \
#          -e LOADTEST_DATABASE_URL='postgresql://...' \
#          mayogu-loadtest:latest npm run loadtest:db:up
#   2. Start server:
#        docker run -d --name loadtest -p 3401:3401 \
#          -v mayogu-data:/data \
#          -e LOADTEST_HOST=0.0.0.0 \
#          -e LOADTEST_DATABASE_URL='postgresql://...' \
#          -e LOADTEST_AUTH_SECRET='<hex ≥ 32 ký tự>' \
#          -e LOADTEST_OTP_SECRET='<khớp OTP_SECRET gateway>' \
#          -e LOADTEST_REDIS_URL='redis://...' \
#          -e LOGTEST_LOG_FILE=/data/logs/loadtest.jsonl \
#          mayogu-loadtest:latest
#
#   ⚠️ LOADTEST_HOST=0.0.0.0 BẮT BUỘC trong Docker — mặc định 127.0.0.1 sẽ
#   chỉ lắng nghe loopback bên trong container (máy ngoài không gọi được).
#   Không đưa secret nào vào Dockerfile — chỉ qua -e / -v.

FROM node:22-alpine
WORKDIR /app

# npm ci — cài cả devDependencies vì tsx (runtime TS runner) là devDep.
# Zero-dep runtime của loadtest/ được giữ nguyên — tsx chỉ là launcher.
COPY package.json package-lock.json ./
RUN npm ci

# Chỉ copy code loadtest/ + package.json (health.ts import '../package.json').
# .dockerignore chặn loadtest/.env + loadtest/data (secret) vào image.
COPY loadtest ./loadtest

# Volume gợi ý cho data (accounts pool, auth-secret, JSONL logs) — mount ngoài.
VOLUME ["/data"]

ENV LOADTEST_HOST=0.0.0.0 \
    LOADTEST_PORT=3401 \
    LOADTEST_DATA_DIR=/data \
    LOADTEST_REPORTS_DIR=/data/reports

EXPOSE 3401
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:3401/api/loadtest/health || exit 1

CMD ["npm", "run", "loadtest:server"]
