# chat-app frontend — 2-stage production image.
#
# Build:
#   docker build -f docker/Dockerfile.frontend -t mayogu-chat-app:latest .
#   # gateway ở origin khác (prod topology): truyền build-arg để CSP meta
#   # (VITE_GATEWAY_URL) và runtime API base cho đúng:
#   docker build -f docker/Dockerfile.frontend \
#     --build-arg VITE_GATEWAY_URL=https://gateway.mayogu.test \
#     -t mayogu-chat-app:latest .
#
# Chạy:
#   docker run -d -p 8080:80 mayogu-chat-app:latest
#   # healthcheck: wget -qO- http://localhost/healthz (nginx, 200 = healthy)

# ── Stage 1: build (Vite + tsc) ──
FROM node:22-alpine AS build
WORKDIR /app

# Build-arg cho Vite (giá trị mặc định khớp src/lib/env.ts + vite.config.ts)
ARG VITE_GATEWAY_URL=http://localhost:3000
ARG VITE_SOCKET_PATH=/socket.io/
ARG VITE_REFRESH_ENDPOINT=/auth/refresh-token
ARG VITE_CSP_CONNECT_SRC=

# npm ci — cần package-lock.json (đã commit). Install độc lập để cache layer.
COPY package.json package-lock.json ./
RUN npm ci

# Copy source (node_modules/.env bị loại bởi docker/.dockerignore)
COPY . .
RUN npm run build

# ── Stage 2: nginx (serve dist/ + SPA fallback + /healthz) ──
FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Không chạy nginx làm PID 1 (docker-entrypoint wrapper xử lý SIGTERM đúng)
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/healthz || exit 1
