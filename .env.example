# Base URL cua gateway-auth-service (auth + websocket + proxy REST sang content-service)
# gateway-auth-service chay PORT=3000 (xem gateway-auth-service/.env). Doc CHAT_API ghi 3005 lac thu.
VITE_GATEWAY_URL=http://localhost:3000

# Duong dan socket.io ma gateway phuc vu (mac dinh /socket.io/)
VITE_SOCKET_PATH=/socket.io/

# Endpoint refresh token — khớp gateway-auth-service POST /auth/refresh-token (auth.controller.ts:314)
VITE_REFRESH_ENDPOINT=/auth/refresh-token
