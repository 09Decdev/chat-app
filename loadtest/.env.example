# MAYogu LoadTest Tool — cấu hình server (đặt cạnh file này, tên `.env`)

# Port của HTTP API điều khiển + polling dashboard
LOADTEST_PORT=3401
# Host API điều khiển — mặc định 127.0.0.1 (chỉ truy cập local; cluster v1.1 set 0.0.0.0)
LOADTEST_HOST=127.0.0.1

# ---- Môi trường test (SD-1: allowlist chặn cứng) ----
# Danh sách URL gateway test được phép chạy, phân tách bằng dấu phẩy.
# Mọi URL khác (production!) bị chặn cứng khi POST /start.
# Nếu để trống → MẶC ĐỊNH cho phép localhost:3000 (chỉ dev).
LOADTEST_ALLOWLIST=http://localhost:3000,ws://localhost:3000

# ---- Hệ thống thật (test env) ----
# Gateway (HTTP REST + Socket.IO) — tool tự normalize ws:// -> http://
LOADTEST_GATEWAY_URL=http://localhost:3000
# Secret dùng để seed OTP register (AF-1) — PHẢI khớp OTP_SECRET của gateway-auth-service.
# Bắt buộc ≥ 32 ký tự (validateEnv fail-fast khi sai/thiếu trong production).
LOADTEST_OTP_SECRET=
# Redis có quyền ghi (seed otp:register:* + đọc queue-count + cleanup) — NÊN là Redis test riêng
LOADTEST_REDIS_URL=redis://localhost:6379

# ---- Database (Postgres) ----
# Lưu run history + pool + metrics + log (instance postgres-loadtest, port 5439)
# BẮT BUỘC cấu hình khi LOADTEST_DB_REQUIRED=true (mặc định true — Q-2): server fail-fast nếu thiếu.
# Đây là placeholder — thay bằng connection string thật của bạn.
LOADTEST_DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB
# Bắt buộc DB phải lên để server start (Q-2). Đặt false chỉ để dev/rollback tạm — run sẽ KHÔNG ghi history.
LOADTEST_DB_REQUIRED=true

# ---- Admin auth (dashboard) ----
# Secret ký session token (HMAC-SHA256). Nếu để trống → tự sinh + lưu dataDir/auth-secret.json
# (sessions sống qua restart). Đặt secret cố định để token không đổi giữa các lần restart.
# Production: BẮT BUỘC set (≥ 32 ký tự) — validateEnv fail-fast nếu thiếu.
# LOADTEST_AUTH_SECRET=

# ---- Giới hạn an toàn (SD-1 / E10 / E1) ----
# Target tối đa 1 run (chặn cứng preset 1M/10M; override chỉ khi thực sự có cluster)
LOADTEST_MAX_TARGET=200000
# Duration tối đa (phút) — access token TTL 1h (PRD §5.3)
LOADTEST_MAX_DURATION_MIN=60
# Register ramp tối đa (req/s) — tránh bucket guest:{ip} 1000/8s của gateway
LOADTEST_MAX_REGISTER_RAMP=100

# ---- Sinh tải ----
# Số worker processes (mặc định: auto = min(cpu-1, ceil(target/10000), 32))
# LOADTEST_WORKERS=4
# Số socket tối đa mỗi worker (PRD §5.1: 2.5k-10k/worker an toàn, tối đa ~50k)
LOADTEST_MAX_SOCKETS_PER_WORKER=10000
# Outbox pending tối đa / user chat (backpressure — PRD §5.1)
LOADTEST_MAX_PENDING_OUTBOX=1000

# ---- Báo cáo ----
# Thư mục lưu report (JSON/MD/CSV) + token pool + settings
LOADTEST_DATA_DIR=./loadtest/data
LOADTEST_REPORTS_DIR=./docs/loadtest-reports

# ---- Gateway /metrics (server-side view, DB-3) ----
LOADTEST_SCRAPE_METRICS_INTERVAL_MS=5000

# ---- Debug ----
# Khi bật (1), server in nguồn từng key (process.env / .env file / override) khi start (C-4).
LOADTEST_DEBUG=0
