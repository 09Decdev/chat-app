# MAYogu LoadTest Tool — cấu hình server (đặt cạnh file này, tên `.env`)

# Port của HTTP API điều khiển + polling dashboard
LOADTEST_PORT=3401
# Host API điều khiển — mặc định 127.0.0.1 (chỉ truy cập local; cluster v1.1 set 0.0.0.0)
LOADTEST_HOST=127.0.0.1

# ---- Môi trường test (SD-1: allowlist chặn cứng) ----
# Danh sách URL gateway test được phép chạy, phân tách bằng dấu phẩy.
# Mọi URL khác (production!) bị chặn cứng khi POST /start.
# Nếu để trống → MẶC ĐỊNH cho phép localhost:3000 (chỉ dev).
# PROD: thêm https://api.mayogu.com (normalize ws/wss tự động).
LOADTEST_ALLOWLIST=http://localhost:3000,https://api.mayogu.com

# ---- Hệ thống thật (test env) ----
# Gateway (HTTP REST + Socket.IO) — tool tự normalize ws:// -> http://
# PROD: https://api.mayogu.com · Dev: http://localhost:3000
LOADTEST_GATEWAY_URL=https://api.mayogu.com
# Secret dùng để seed OTP register (AF-1) — PHẢI khớp OTP_SECRET của gateway-auth-service.
# Bắt buộc ≥ 32 ký tự (validateEnv fail-fast khi sai/thiếu trong production).
LOADTEST_OTP_SECRET=
# Redis có quyền ghi (seed otp:register:* + đọc queue-count + cleanup) — NÊN là Redis test riêng
LOADTEST_REDIS_URL=redis://localhost:6379

# ---- Database (Postgres) ----
# Lưu run history + pool + metrics + log (instance postgres-loadtest, port 5439)
# BẮT BUỘC cấu hình khi LOADTEST_DB_REQUIRED=true (mặc định true — Q-2): server fail-fast nếu thiếu.
# Đây là placeholder — thay bằng connection string thật của bạn.
LOADTEST_DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB
# Bắt buộc DB phải lên để server start (Q-2). Đặt false chỉ để dev/rollback tạm — run sẽ KHÔNG ghi history.
LOADTEST_DB_REQUIRED=true

# ---- Admin auth (dashboard) ----
# Secret ký session token (HMAC-SHA256). Nếu để trống → tự sinh + lưu dataDir/auth-secret.json
# (sessions sống qua restart). Đặt secret cố định để token không đổi giữa các lần restart.
# Production: BẮT BUỘC set (≥ 32 ký tự) — validateEnv fail-fast nếu thiếu.
# LOADTEST_AUTH_SECRET=

# ---- T-06: harden API (CORS / register gate / rate-limit / shutdown) ----
# CORS allowlist (comma-separated) — echo origin nếu khớp, KHÔNG `*` (SEC-2). Default http://localhost:5173 (R-7).
LOADTEST_CORS_ORIGIN=http://localhost:5173
# Register gate: false = POST /auth/register trả 403 (SEC-6). Dev set true để register.
LOADTEST_ALLOW_REGISTER=false
# Rate-limit escape hatch (test/CI): 1 = tắt mọi rate-limit (PLAN R-6).
LOADTEST_RATE_LIMIT_DISABLED=0
# Số fail login/register trong window → 429 (mặc định 5).
LOADTEST_RATE_LIMIT_LOGIN_FAILS=5
# Cửa sổ fail window (ms) — mặc định 60s.
LOADTEST_RATE_LIMIT_WINDOW_MS=60000
# Refill interval /start bucket (ms) — mặc định 10s (1 req/10s).
LOADTEST_RATE_LIMIT_START_MS=10000
# Write bucket (req/min) cho /allowlist POST, /cleanup, DELETE /runs — 0 = OFF (mặc định).
LOADTEST_RATE_LIMIT_WRITE_BUCKET=0
# Tin X-Forwarded-For (chống spoof header) — chỉ bật khi sau reverse-proxy.
LOADTEST_TRUST_PROXY=0
# Tổng timeout graceful shutdown (ms) — mặc định 10s (PRD §5.2).
LOADTEST_SHUTDOWN_TIMEOUT_MS=10000

# ---- Giới hạn an toàn (SD-1 / E10 / E1) ----
# Target tối đa 1 run (chặn cứng preset 1M/10M; override chỉ khi thực sự có cluster)
LOADTEST_MAX_TARGET=200000
# Duration tối đa (phút) — access token TTL 1h (PRD §5.3)
LOADTEST_MAX_DURATION_MIN=60
# Register ramp tối đa (req/s) — tránh bucket guest:{ip} 1000/8s của gateway
LOADTEST_MAX_REGISTER_RAMP=100

# ---- Sinh tải ----
# Account pool (seed trước, reuse login): seed account mẫu 1 lần vào DB, các run sau
# login lại (useExistingAccounts mặc định) thay vì register mỗi lần:
#   npm run loadtest:seed-accounts -- <accounts.json|csv> [--pool-id <id>] [--gateway-url <url>]
# Không có pool DB → fallback pool file disk (loadtest/data/accounts-*.json) → register mới.
# Xem README mục "Account pool (dùng account có sẵn)".
# Chế độ "chỉ dùng pool file": KHÔNG BAO GIỜ register account mới — nạp account từ file JSON này
# (mảng [{email,password,...}] hoặc { accounts: [...] }), login lại rồi chạy. Pool cạn → fail run sớm.
# RỖNG (mặc định) = hành vi cũ: pool DB → pool disk → register OTP-Seed.
LOADTEST_POOL_FILE=
# Số worker processes (mặc định: auto = min(cpu-1, ceil(target/10000), 32))
# LOADTEST_WORKERS=4
# Số socket tối đa mỗi worker (PRD §5.1: 2.5k-10k/worker an toàn, tối đa ~50k)
LOADTEST_MAX_SOCKETS_PER_WORKER=10000
# Outbox pending tối đa / user chat (backpressure — PRD §5.1)
LOADTEST_MAX_PENDING_OUTBOX=1000
# Register ramp (req/s) cho OTP-Seed register + login reuse pool (AF-3) — mặc định 100.
LOADTEST_REGISTER_RAMP=100
# Post id fixtures cho REST driver (comma-separated). Để TRỐNG → driver tự lấy id từ feed mới nhất.
# Set khi feed của gateway test trống (bỏ qua bước read/view/comment/like — NO_POST_FIXTURE).
LOADTEST_FIXTURE_POST_IDS=
# Giới hạn mọi action lấy post (like/comment/view/read) vào đúng 1 community id.
# RỖNG = toàn app (hành vi cũ). Set → fetch post theo community; 403/items rỗng → fallback getAll + lọc local.
LOADTEST_COMMUNITY_ID=
# Số request register/login chạy SONG SONG khi provisioning (AF-2) — mặc định 25.
# Tuần tự = latency/request → 10k users mất hàng chục phút. Tăng khi gateway chịu được.
LOADTEST_PROVISION_CONCURRENCY=25

# ---- Báo cáo ----
# Thư mục lưu report (JSON/MD/CSV) + token pool + settings
LOADTEST_DATA_DIR=./loadtest/data
LOADTEST_REPORTS_DIR=./docs/loadtest-reports

# ---- Gateway /metrics (server-side view, DB-3) ----
LOADTEST_SCRAPE_METRICS_INTERVAL_MS=5000

# ---- Debug ----
# Khi bật (1), server in nguồn từng key (process.env / .env file / override) khi start (C-4).
LOADTEST_DEBUG=0

# ---- T-07: Observability (structured log) ----
# File JSONL (append + rotation 10MB → .1/.2 ... giữ 5). Để TRỐNG → không ghi file (mặc định).
LOGTEST_LOG_FILE=
# Console JSON 1 dòng (1 = prod; 0 = giữ text `[lt]...` dev). Ring buffer/dashboard luôn text.
LOADTEST_LOG_JSON=0
